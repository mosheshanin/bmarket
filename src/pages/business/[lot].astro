---
import Layout from '../../layouts/Layout.astro';
import Gallery from '../../components/Gallery.tsx';
import GonePage from '../../components/GonePage.astro';
import { loadCard, youtubeId } from '../../server/card';
import { getDisplayRate, imageUrl, isIllustrativePhoto } from '../../server/public';
import { db, env, site } from '../../server/site';
import {
  formatIls, formatUsd, formatEur, formatPayback, formatIsoDate, groupDigits,
  LEGAL_FORM_LABELS, LICENSE_LABELS, INCLUDED_LABELS,
} from '../../lib/format';
import { renderMarkdown } from '../../lib/markdown';
import { businessPath } from '../../lib/slug';
import Icon from '../../components/ToneIcon.astro';
import TrustBadge from '../../components/TrustBadge.astro';
import { ICON } from '../../lib/icons';
import { extraByKey } from '../../lib/extras';

const d = db();
const s = site();
const res = await loadCard(env, d, Astro.params.lot ?? '', Astro.url);

if (res.kind === 'redirect') {
  return new Response(null, { status: 301, headers: { location: res.to, 'x-bm-cacheable': '1' } });
}
const rate = await getDisplayRate(d);
if (res.kind !== 'ok' || !res.preview) Astro.response.headers.set('x-bm-cacheable', '1');
if (res.kind === 'notfound') {
  return Astro.rewrite('/404');
}
if (res.kind === 'gone') Astro.response.status = 410;

const b = res.kind === 'ok' || res.kind === 'gone' ? res.b : null!;
const preview = res.kind === 'ok' && res.preview;
const path = businessPath(b.lotNumber, b.slug);
const photos = b.photos.map((p) => ({
  src: imageUrl(env, p.r2Key),
  srcSmall: imageUrl(env, p.r2KeySmall),
  width: p.width,
  height: p.height,
  alt: p.alt || b.publicTitle,
  illustrative: isIllustrativePhoto(p.r2Key),
}));
const ogImage = photos[0] ? new URL(photos[0].src, s.url).href : null;
const priceStr = b.priceIls ? formatIls(b.priceIls) : null;
const title = `${b.publicTitle}${priceStr ? ` — ${priceStr}` : ''} | ${s.name}`;

const kpis = [
  b.monthlyRevenueIls && { label: 'Оборот в месяц', value: formatIls(b.monthlyRevenueIls), tone: 'tone-blue', icon: ICON.revenue },
  b.monthlyProfitIls && { label: 'Чистая прибыль в месяц', value: formatIls(b.monthlyProfitIls), tone: 'tone-green', icon: ICON.profit },
  b.paybackMonths && { label: 'Окупаемость', value: formatPayback(b.paybackMonths), tone: 'tone-violet', icon: ICON.payback },
  b.rentMonthlyIls && { label: 'Аренда в месяц', value: formatIls(b.rentMonthlyIls), tone: 'tone-amber', icon: ICON.rent },
].filter(Boolean) as { label: string; value: string; tone: string; icon: string }[];

const specs = [
  b.yearFounded && ['Год открытия', String(b.yearFounded)],
  b.employeesCount != null && b.employeesCount > 0 && ['Сотрудники', `${b.employeesCount}`],
  b.areaSqm && ['Площадь', `${groupDigits(b.areaSqm)} м²`],
  b.leaseUntil && ['Аренда до', formatIsoDate(b.leaseUntil)],
  b.legalForm && ['Форма собственности', LEGAL_FORM_LABELS[b.legalForm]],
  b.businessLicense && ['Лицензия на бизнес', LICENSE_LABELS[b.businessLicense]],
  b.ownerSupport && ['Передача дел', b.ownerSupport],
].filter(Boolean) as [string, string][];

const trust = [b.valuationVerifiedAt && 'valuation', b.auditPassedAt && 'audit'].filter(Boolean) as ('valuation' | 'audit')[];
const included = (b.includedInSale ?? []).map((k) => INCLUDED_LABELS[k]).filter(Boolean);
const yt = youtubeId(b.videoUrl);
const descriptionHtml = renderMarkdown(b.description);
const requestPath = `${path}/request${preview ? Astro.url.search : ''}`;

const jsonLd = res.kind === 'ok' && !preview ? [
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: b.publicTitle,
    description: b.shortDescription,
    sku: `LOT-${b.lotNumber}`,
    category: b.categoryName ?? undefined,
    image: photos.slice(0, 5).map((p) => new URL(p.src, s.url).href),
    url: s.url + path,
    ...(b.priceIls ? {
      offers: {
        '@type': 'Offer',
        price: b.priceIls,
        priceCurrency: 'ILS',
        availability: 'https://schema.org/InStock',
        url: s.url + path,
        areaServed: { '@type': 'Country', name: 'Israel' },
      },
    } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Главная', item: s.url + '/' },
      ...(b.citySlug ? [{ '@type': 'ListItem', position: 2, name: b.cityName, item: `${s.url}/city/${b.citySlug}` }] : []),
      { '@type': 'ListItem', position: b.citySlug ? 3 : 2, name: b.publicTitle, item: s.url + path },
    ],
  },
] : [];
---

{
  res.kind === 'gone' ? (
    <GonePage b={res.b} others={res.others} rate={rate} />
  ) : (
    <Layout
      title={title}
      description={b.shortDescription}
      canonicalPath={path}
      ogImage={ogImage}
      ogType="product"
      jsonLd={jsonLd}
      noindex={preview}
      data={{ page: 'card', 'business-id': b.id, lot: b.lotNumber, 'request-path': requestPath, title: b.publicTitle }}
    >
      {preview && (
        <div class="mb-3 rounded-card bg-warn p-3 text-sm font-semibold">Предпросмотр — так карточку увидит посетитель. Статус: {b.status === 'draft' ? 'черновик' : b.status === 'hidden' ? 'снят' : 'опубликован'}.</div>
      )}
      <nav aria-label="Навигация" class="web-only mb-3 text-sm text-hint">
        <a href="/">Каталог</a>
        {b.citySlug && <> · <a href={`/city/${b.citySlug}`}>{b.cityName}</a></>}
        <span> · Лот №{b.lotNumber}</span>
      </nav>

      <div class="grid grid-cols-1 gap-4 lg:grid-cols-[minmax(0,1fr)_360px] lg:gap-6">
        <div class="lg:col-start-1">
          <Gallery client:visible photos={photos} title={b.publicTitle} />
        </div>

        <header class="lg:col-start-1">
          <p class="text-sm font-semibold text-hint">Лот №{b.lotNumber}</p>
          <h1 class="mt-0.5 text-2xl font-extrabold leading-tight tracking-tight sm:text-3xl">{b.publicTitle}</h1>
          <p class="mt-1 text-hint">
            {[b.cityName, b.areaNote, b.categoryName].filter(Boolean).join(' · ')}
          </p>
        </header>

        <aside class="lg:col-start-2 lg:row-span-3 lg:row-start-1">
          <div class="tinted tone-blue p-4 lg:sticky lg:top-20">
            <p class="tone-text text-sm font-semibold">Цена продажи</p>
            {priceStr ? (
              <p class="text-3xl font-extrabold tracking-tight">{priceStr}</p>
            ) : (
              <p class="text-xl font-bold">Цена по запросу</p>
            )}
            {b.priceIls && rate && (
              <details class="mt-1 text-sm text-hint">
                <summary class="cursor-pointer list-none">
                  {formatUsd(b.priceIls, rate.usdIls)} · {formatEur(b.priceIls, rate.eurIls)} <span aria-hidden="true">ⓘ</span>
                </summary>
                <p class="mt-1">Пересчёт по курсу Банка Израиля на {formatIsoDate(rate.date)}. Окончательная цена — в шекелях.</p>
              </details>
            )}
            {b.priceNegotiable && <p class="mt-2"><span class="badge bg-success/15 text-success">Торг возможен</span></p>}
            {
              trust.length > 0 && (
                <ul class="mt-3 flex flex-col gap-2.5 border-t border-line pt-3">
                  {trust.map((k) => (
                    <li>
                      <TrustBadge kind={k} large />
                      <p class="mt-1 text-sm text-hint">{extraByKey(k)!.explain}</p>
                    </li>
                  ))}
                </ul>
              )
            }
            <a href={requestPath} class="web-only btn btn-primary mt-4 hidden w-full lg:flex" data-cta>Узнать подробнее</a>
            <button type="button" class="btn btn-secondary mt-2 w-full" data-share data-share-title={b.publicTitle} data-share-lot={b.lotNumber}>Поделиться</button>
          </div>
        </aside>

        <div class="flex flex-col gap-4 lg:col-start-1">
          {kpis.length > 0 && (
            <section aria-label="Ключевые показатели" class="grid grid-cols-2 gap-3">
              {kpis.map((k) => (
                <div class={`tinted ${k.tone} p-3.5`}>
                  <div class="flex items-center gap-2">
                    <Icon d={k.icon} small />
                    <p class="tone-text text-xs font-semibold sm:text-sm">{k.label}</p>
                  </div>
                  <p class="mt-1.5 text-lg font-bold">{k.value}</p>
                </div>
              ))}
            </section>
          )}

          <section class="card p-4">
            <h2 class="mb-2 flex items-center gap-2.5 text-lg font-bold"><span class="tone-slate"><Icon d={ICON.desc} /></span>Описание</h2>
            <div class="prose-md" set:html={descriptionHtml} />
          </section>

          {included.length > 0 && (
            <section class="tinted tone-green p-4">
              <h2 class="mb-2 flex items-center gap-2.5 text-lg font-bold"><Icon d={ICON.included} />Что входит в продажу</h2>
              <ul class="grid gap-1.5 sm:grid-cols-2">
                {included.map((i) => (
                  <li class="flex items-start gap-2"><span class="tone-text font-bold" aria-hidden="true">✓</span>{i}</li>
                ))}
              </ul>
            </section>
          )}

          {specs.length > 0 && (
            <section class="tinted tone-teal p-4">
              <h2 class="mb-2 flex items-center gap-2.5 text-lg font-bold"><Icon d={ICON.specs} />Характеристики</h2>
              <dl class="divide-y divide-line">
                {specs.map(([k, v]) => (
                  <div class="flex justify-between gap-4 py-2">
                    <dt class="text-hint">{k}</dt>
                    <dd class="text-right font-medium">{v}</dd>
                  </div>
                ))}
              </dl>
            </section>
          )}

          {b.reasonForSale && (
            <section class="tinted tone-amber p-4">
              <h2 class="mb-2 flex items-center gap-2.5 text-lg font-bold"><Icon d={ICON.reason} />Причина продажи</h2>
              <p class="whitespace-pre-line">{b.reasonForSale}</p>
            </section>
          )}

          {yt && (
            <section class="card overflow-hidden">
              <h2 class="flex items-center gap-2.5 p-4 pb-2 text-lg font-bold"><span class="tone-violet"><Icon d={ICON.video} /></span>Видео</h2>
              <button type="button" class="relative block aspect-video w-full bg-black" data-yt={yt} aria-label="Смотреть видео">
                <img src={`https://i.ytimg.com/vi/${yt}/hqdefault.jpg`} alt="" loading="lazy" class="h-full w-full object-cover opacity-90" width="480" height="360" />
                <span class="absolute inset-0 m-auto flex h-16 w-16 items-center justify-center rounded-full bg-black/70 text-3xl text-white">▶</span>
              </button>
            </section>
          )}

          <p class="tinted tone-slate flex items-center gap-2.5 p-3 text-sm">
            <Icon d={ICON.lock} small />
            Название и точный адрес сообщаются после заявки.
          </p>
        </div>
      </div>

      <div class="web-only fixed inset-x-0 bottom-0 z-30 border-t border-line bg-card/95 p-3 backdrop-blur lg:hidden" style="padding-bottom: max(0.75rem, env(safe-area-inset-bottom));">
        <a href={requestPath} class="btn btn-primary w-full" data-cta>Узнать подробнее</a>
      </div>
    </Layout>
  )
}
<script>
  document.querySelectorAll<HTMLButtonElement>('[data-yt]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const f = document.createElement('iframe');
      f.src = `https://www.youtube-nocookie.com/embed/${btn.dataset.yt}?autoplay=1&rel=0`;
      f.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      f.allowFullscreen = true;
      f.title = 'Видео';
      f.className = 'aspect-video w-full';
      btn.replaceWith(f);
    });
  });
</script>
