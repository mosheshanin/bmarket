---
import Layout from '../../layouts/Layout.astro';
import Gallery from '../../components/Gallery.tsx';
import GonePage from '../../components/GonePage.astro';
import { loadCard, youtubeId } from '../../server/card';
import { getDisplayRate, imageUrl, isIllustrativePhoto } from '../../server/public';
import { db, env, site } from '../../server/site';
import {
  formatIls, formatUsd, formatEur, formatPayback, formatIsoDate, groupDigits,
  LEGAL_FORM_LABELS, LICENSE_LABELS, INCLUDED_LABELS,
} from '../../lib/format';
import { renderMarkdown } from '../../lib/markdown';
import { businessPath } from '../../lib/slug';
import PaybackRing from '../../components/PaybackRing.astro';
import { extraByKey } from '../../lib/extras';

const d = db();
const s = site();
const res = await loadCard(env, d, Astro.params.lot ?? '', Astro.url);

if (res.kind === 'redirect') {
  return new Response(null, { status: 301, headers: { location: res.to, 'x-bm-cacheable': '1' } });
}
const rate = await getDisplayRate(d);
if (res.kind !== 'ok' || !res.preview) Astro.response.headers.set('x-bm-cacheable', '1');
if (res.kind === 'notfound') {
  return Astro.rewrite('/404');
}
if (res.kind === 'gone') Astro.response.status = 410;

const b = res.kind === 'ok' || res.kind === 'gone' ? res.b : null!;
const preview = res.kind === 'ok' && res.preview;
const path = businessPath(b.lotNumber, b.slug);
const photos = b.photos.map((p) => ({
  src: imageUrl(env, p.r2Key),
  srcSmall: imageUrl(env, p.r2KeySmall),
  width: p.width,
  height: p.height,
  alt: p.alt || b.publicTitle,
  illustrative: isIllustrativePhoto(p.r2Key),
}));
const ogImage = photos[0] ? new URL(photos[0].src, s.url).href : null;
const priceStr = b.priceIls ? formatIls(b.priceIls) : null;
const title = `${b.publicTitle}${priceStr ? ` — ${priceStr}` : ''} | ${s.name}`;

// Ведомость цифр досье. Подписи — как в ТЗ (их проверяют сквозные тесты).
const kpis = [
  b.monthlyRevenueIls && { label: 'Оборот в месяц', value: formatIls(b.monthlyRevenueIls) },
  b.monthlyProfitIls && { label: 'Чистая прибыль в месяц', value: formatIls(b.monthlyProfitIls) },
  b.paybackMonths && { label: 'Окупаемость', value: formatPayback(b.paybackMonths), months: b.paybackMonths },
  b.rentMonthlyIls && { label: 'Аренда в месяц', value: formatIls(b.rentMonthlyIls) },
].filter(Boolean) as { label: string; value: string; months?: number }[];
/** Текст кнопки заявки — как у системной кнопки Telegram (src/scripts/app.ts, CTA_TEXT). */
const CTA = 'Узнать название и адрес';

const specs = [
  b.yearFounded && ['Год открытия', String(b.yearFounded)],
  b.employeesCount != null && b.employeesCount > 0 && ['Сотрудники', `${b.employeesCount}`],
  b.areaSqm && ['Площадь', `${groupDigits(b.areaSqm)} м²`],
  b.leaseUntil && ['Аренда до', formatIsoDate(b.leaseUntil)],
  b.legalForm && ['Форма собственности', LEGAL_FORM_LABELS[b.legalForm]],
  b.businessLicense && ['Лицензия на бизнес', LICENSE_LABELS[b.businessLicense]],
  b.ownerSupport && ['Передача дел', b.ownerSupport],
].filter(Boolean) as [string, string][];

const trust = [b.valuationVerifiedAt && 'valuation', b.auditPassedAt && 'audit'].filter(Boolean) as ('valuation' | 'audit')[];
const included = (b.includedInSale ?? []).map((k) => INCLUDED_LABELS[k]).filter(Boolean);
const yt = youtubeId(b.videoUrl);
const descriptionHtml = renderMarkdown(b.description);
const requestPath = `${path}/request${preview ? Astro.url.search : ''}`;

const jsonLd = res.kind === 'ok' && !preview ? [
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: b.publicTitle,
    description: b.shortDescription,
    sku: `LOT-${b.lotNumber}`,
    category: b.categoryName ?? undefined,
    image: photos.slice(0, 5).map((p) => new URL(p.src, s.url).href),
    url: s.url + path,
    ...(b.priceIls ? {
      offers: {
        '@type': 'Offer',
        price: b.priceIls,
        priceCurrency: 'ILS',
        availability: 'https://schema.org/InStock',
        url: s.url + path,
        areaServed: { '@type': 'Country', name: 'Israel' },
      },
    } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Главная', item: s.url + '/' },
      ...(b.citySlug ? [{ '@type': 'ListItem', position: 2, name: b.cityName, item: `${s.url}/city/${b.citySlug}` }] : []),
      { '@type': 'ListItem', position: b.citySlug ? 3 : 2, name: b.publicTitle, item: s.url + path },
    ],
  },
] : [];
---

{
  res.kind === 'gone' ? (
    <GonePage b={res.b} others={res.others} rate={rate} />
  ) : (
    <Layout
      title={title}
      description={b.shortDescription}
      canonicalPath={path}
      ogImage={ogImage}
      ogType="product"
      jsonLd={jsonLd}
      noindex={preview}
      data={{ page: 'card', 'business-id': b.id, lot: b.lotNumber, 'request-path': requestPath, title: b.publicTitle }}
    >
      {preview && (
        <div class="mb-3 rounded-card bg-warn p-3 text-sm font-semibold">Предпросмотр — так карточку увидит посетитель. Статус: {b.status === 'draft' ? 'черновик' : b.status === 'hidden' ? 'снят' : 'опубликован'}.</div>
      )}
      <nav aria-label="Навигация" class="web-only mb-3 text-sm text-hint">
        <a href="/">Каталог</a>
        {b.citySlug && <> · <a href={`/city/${b.citySlug}`}>{b.cityName}</a></>}
        <span> · Лот №{b.lotNumber}</span>
      </nav>

      <!-- Досье (концепция «Закрытый клуб», DECISIONS №46). -->
      <div class="grid grid-cols-1 gap-5 lg:grid-cols-[minmax(0,1fr)_360px] lg:gap-7">
        <div class="lg:col-start-1">
          <Gallery client:visible photos={photos} title={b.publicTitle} vtName={`lot-${b.lotNumber}`} />
        </div>

        <header class="lg:col-start-1">
          <p class="caps text-brass">Досье №&nbsp;{b.lotNumber}{b.cityName && <> · {[b.cityName, b.areaNote].filter(Boolean).join(', ')}</>}</p>
          <h1 class="serif mt-2 text-[2.1rem] leading-[1.04] sm:text-[2.6rem]">{b.publicTitle}</h1>
          <p class="mt-2 text-hint">
            {[b.cityName, b.areaNote, b.categoryName].filter(Boolean).join(' · ')}
          </p>
        </header>

        <aside class="lg:col-start-2 lg:row-span-3 lg:row-start-1">
          <div class="sheet lg:sticky lg:top-20">
            <p class="caps text-hint">Цена продажи</p>
            {priceStr ? (
              <p class="serif mt-1 text-[2.6rem] leading-none" data-count={b.priceIls}>{priceStr}</p>
            ) : (
              <p class="serif mt-1 text-2xl">Цена по запросу</p>
            )}
            {b.priceIls && rate && (
              <details class="mt-2 text-sm text-hint">
                <summary class="cursor-pointer list-none">
                  {formatUsd(b.priceIls, rate.usdIls)} · {formatEur(b.priceIls, rate.eurIls)} <span aria-hidden="true">ⓘ</span>
                </summary>
                <p class="mt-1">Пересчёт по курсу Банка Израиля на {formatIsoDate(rate.date)}. Окончательная цена — в шекелях.</p>
              </details>
            )}
            {b.priceNegotiable && <p class="mt-2.5"><span class="trust-badge">Торг возможен</span></p>}
            {
              trust.length > 0 && (
                <ul class="mt-4 flex flex-col gap-4 border-t border-line pt-4">
                  {trust.map((k) => (
                    <li class="flex items-center gap-4">
                      <span class="stamp" data-inview>{k === 'valuation' ? <>Оценка<br />подтверждена</> : <>Пройден<br />аудит</>}</span>
                      <span class="min-w-0">
                        <span class="block font-bold">{extraByKey(k)!.badge}</span>
                        <span class="mt-0.5 block text-sm text-hint">{extraByKey(k)!.explain}</span>
                      </span>
                    </li>
                  ))}
                </ul>
              )
            }
            <a href={requestPath} class="web-only btn btn-primary press mt-5 hidden w-full lg:flex" data-cta>{CTA}</a>
            <button type="button" class="btn btn-secondary press mt-2 w-full" data-share data-share-title={b.publicTitle} data-share-lot={b.lotNumber} data-haptic>Поделиться</button>
          </div>
        </aside>

        <div class="flex flex-col gap-4 lg:col-start-1">
          <button type="button" class="sheet press flex w-full flex-col gap-2.5 text-left" data-scramble-group aria-describedby="secret-note">
            <span class="caps text-brass">Под грифом</span>
            <span class="flex items-center gap-3 text-sm"><span class="w-20 shrink-0 text-hint">Название</span><span class="redact" style="width: 9.5rem" aria-hidden="true"></span></span>
            <span class="flex items-center gap-3 text-sm"><span class="w-20 shrink-0 text-hint">Адрес</span><span>ул. <span class="redact" style="width: 5rem" aria-hidden="true"></span>{b.cityName && <>, {b.cityName}</>}</span></span>
            <span class="flex items-center gap-3 text-sm"><span class="w-20 shrink-0 text-hint">Продавец</span><span class="redact" style="width: 7.5rem" aria-hidden="true"></span></span>
            <span id="secret-note" class="mt-1 text-sm text-hint">Название и точный адрес сообщаются после заявки.</span>
            <span class="text-sm font-semibold text-brass" data-scramble-hint hidden>Нажмите «{CTA}» — менеджер клуба свяжется с вами и расскажет всё о бизнесе.</span>
          </button>

          {kpis.length > 0 && (
            <section aria-label="Ключевые показатели" class="sheet">
              <h2 class="sheet-title">Цифры</h2>
              <dl class="ledger">
                {kpis.map((k) => (
                  <div class="ledger-row">
                    <dt>{k.label}</dt>
                    <i aria-hidden="true"></i>
                    <dd class="flex items-center gap-2">{k.months && <PaybackRing months={k.months} size={30} />}{k.value}</dd>
                  </div>
                ))}
              </dl>
            </section>
          )}

          <section class="sheet">
            <h2 class="sheet-title">Описание</h2>
            <div class="prose-md" set:html={descriptionHtml} />
          </section>

          {included.length > 0 && (
            <section class="sheet">
              <h2 class="sheet-title">Что входит в продажу</h2>
              <ul class="grid gap-2 sm:grid-cols-2">
                {included.map((i) => (
                  <li class="flex items-start gap-2.5"><span class="font-bold text-brass" aria-hidden="true">✓</span>{i}</li>
                ))}
              </ul>
            </section>
          )}

          {specs.length > 0 && (
            <section class="sheet">
              <h2 class="sheet-title">Характеристики</h2>
              <dl class="divide-y divide-line">
                {specs.map(([k, v]) => (
                  <div class="flex justify-between gap-4 py-2.5">
                    <dt class="text-hint">{k}</dt>
                    <dd class="text-right font-semibold">{v}</dd>
                  </div>
                ))}
              </dl>
            </section>
          )}

          {b.reasonForSale && (
            <section class="sheet">
              <h2 class="sheet-title">Причина продажи</h2>
              <p class="whitespace-pre-line">{b.reasonForSale}</p>
            </section>
          )}

          {yt && (
            <section class="sheet overflow-hidden !p-0">
              <h2 class="sheet-title p-4 pb-0">Видео</h2>
              <button type="button" class="relative mt-3 block aspect-video w-full bg-black" data-yt={yt} aria-label="Смотреть видео">
                <img src={`https://i.ytimg.com/vi/${yt}/hqdefault.jpg`} alt="" loading="lazy" class="h-full w-full object-cover opacity-90" width="480" height="360" />
                <span class="absolute inset-0 m-auto flex h-16 w-16 items-center justify-center rounded-full bg-black/70 text-3xl text-white">▶</span>
              </button>
            </section>
          )}
        </div>
      </div>

      <div class="web-only fixed inset-x-0 bottom-0 z-30 border-t border-line bg-card/95 p-3 backdrop-blur lg:hidden" style="padding-bottom: max(0.75rem, env(safe-area-inset-bottom));">
        <a href={requestPath} class="btn btn-primary press w-full" data-cta>{CTA}</a>
      </div>
    </Layout>
  )
}
<script>
  document.querySelectorAll<HTMLButtonElement>('[data-yt]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const f = document.createElement('iframe');
      f.src = `https://www.youtube-nocookie.com/embed/${btn.dataset.yt}?autoplay=1&rel=0`;
      f.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      f.allowFullscreen = true;
      f.title = 'Видео';
      f.className = 'aspect-video w-full';
      btn.replaceWith(f);
    });
  });
</script>
