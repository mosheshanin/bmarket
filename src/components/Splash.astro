---
/**
 * Заставка при открытии мини-приложения — ≈3 с (с 12.11.2026, DECISIONS №46; раньше — «аврора», ≈21,5 с).
 * Стиль «Закрытый клуб»: чернильный фон, латунная подпись, антиква. Одна сцена:
 * «HaifaBusinessClub представляет» → BMarket → число досье и цена «от» → латунная линия.
 * Уход — круглый вырез из центра (0,7 с), «Пропустить» — сразу (0,45 с).
 * Показывается только внутри Telegram и только на первой странице открытия (решение — в <head>, класс .splash-on),
 * не показывается в админ-панели и при «уменьшении движения».
 */
import { catalogSummary } from '../server/public';
import { db, site } from '../server/site';
import { groupDigits } from '../lib/format';
import { fromPrice } from '../lib/promo';

const s = site();
let count = 0;
let minPrice: number | null = null;
try {
  const sum = await catalogSummary(db());
  count = sum.count;
  minPrice = sum.minPrice;
} catch {
  /* заставка не должна ломать страницу */
}
const from = fromPrice(minPrice);
---

<div id="bm-splash" class="bm-splash">
  <div class="sp-ring" aria-hidden="true"></div>
  <section class="sp-sc" aria-hidden="true">
    <p class="sp-club sp-in" style="--d:0.05s">HaifaBusinessClub представляет</p>
    <p class="sp-brand sp-in" style="--d:0.25s">{s.name}</p>
    <i class="sp-rule" style="--d:0.7s"></i>
    <p class="sp-lead sp-in" style="--d:0.85s">
      {count ? <><b>{count}</b> досье · </> : null}от ₪&nbsp;{groupDigits(from)}
    </p>
    <p class="sp-note sp-in" style="--d:1.15s">Цифры — сразу. Название и адрес — после заявки.</p>
  </section>
  <button type="button" class="sp-skip" id="bm-splash-skip">Пропустить</button>
</div>

<script is:inline>
  (function () {
    var root = document.documentElement;
    var el = document.getElementById('bm-splash');
    if (!el) return;
    if (!root.classList.contains('splash-on')) {
      el.remove();
      return;
    }
    var finished = false;
    var revealing = false;
    function done() {
      if (finished) return;
      finished = true;
      root.classList.remove('splash-on');
      el.remove();
      window.__bmSplashDone = true;
      window.dispatchEvent(new Event('bm:splash-done'));
    }
    // Раскрытие круглым вырезом из центра; без поддержки CSS @property — плавное исчезновение.
    function reveal(ms) {
      if (revealing) return;
      revealing = true;
      el.style.setProperty('--sp-reveal-t', ms + 'ms');
      if (!(window.CSS && CSS.registerProperty)) el.classList.add('sp-fade');
      el.classList.add('sp-reveal');
      window.dispatchEvent(new Event('bm:splash-reveal'));
      setTimeout(done, ms + 50);
    }
    window.__bmSplashDone = false;
    document.getElementById('bm-splash-skip').addEventListener('click', function () { reveal(450); });
    // Раскрытие начинается в 2,3 с и длится 0,7 с — всего ≈3 с.
    setTimeout(function () { reveal(700); }, 2300);
  })();
</script>

<style is:global>
  .bm-splash { display: none; }
  .splash-on body { overflow: hidden; }
  .splash-on .bm-splash {
    --sp-ease: cubic-bezier(0.16, 1, 0.3, 1);
    display: block;
    position: fixed;
    inset: 0;
    z-index: 100;
    overflow: hidden;
    background: radial-gradient(120% 80% at 50% 35%, #221d17 0%, #13110e 70%);
    color: #f3ecdf;
    font-family: var(--font-sans);
  }
  .sp-sc {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 0 28px;
    text-align: center;
  }
  .sp-in { opacity: 0; animation: sp-rise 0.9s var(--sp-ease) var(--d, 0s) both; }
  .sp-club { margin: 0; font-size: 11px; font-weight: 800; letter-spacing: 0.2em; text-transform: uppercase; color: #d6b370; }
  .sp-brand { margin: 14px 0 0; font-family: var(--serif); font-size: clamp(64px, 21vw, 104px); font-weight: 700; line-height: 0.9; letter-spacing: -0.01em; }
  .sp-rule {
    display: block;
    width: 120px;
    height: 1px;
    margin: 22px 0 0;
    background: #d6b370;
    transform-origin: center;
    animation: sp-draw 0.7s var(--sp-ease) var(--d, 0s) both;
  }
  .sp-lead { margin: 18px 0 0; font-family: var(--serif); font-size: 26px; font-weight: 700; line-height: 1.2; }
  .sp-lead b { color: #d6b370; }
  .sp-note { margin: 10px 0 0; font-size: 14px; font-weight: 500; color: rgba(243, 236, 223, 0.7); }

  .sp-skip {
    position: absolute;
    left: 50%;
    bottom: calc(20px + max(env(safe-area-inset-bottom), var(--tg-safe-area-inset-bottom, 0px)));
    z-index: 8;
    transform: translateX(-50%);
    min-height: 46px;
    padding: 0 24px;
    border: 1px solid rgba(214, 179, 112, 0.45);
    border-radius: 999px;
    background: transparent;
    color: #f3ecdf;
    font: 700 15px var(--font-sans);
    cursor: pointer;
  }

  /* Раскрытие: прозрачный круг в центре растёт до углов экрана (72vmax — больше половины диагонали любого экрана). */
  @property --sp-hole { syntax: '<length>'; inherits: true; initial-value: 0px; }
  .splash-on .bm-splash.sp-reveal {
    -webkit-mask-image: radial-gradient(circle at 50% 50%, transparent var(--sp-hole), #000 calc(var(--sp-hole) + 1.5px));
    mask-image: radial-gradient(circle at 50% 50%, transparent var(--sp-hole), #000 calc(var(--sp-hole) + 1.5px));
    animation: sp-hole var(--sp-reveal-t, 0.7s) cubic-bezier(0.7, 0, 0.25, 1) forwards;
    pointer-events: none;
  }
  /* Латунная кромка выреза. */
  .sp-ring { display: none; }
  .sp-reveal .sp-ring {
    display: block;
    position: absolute;
    z-index: 9;
    left: 50%;
    top: 50%;
    width: calc(var(--sp-hole) * 2);
    height: calc(var(--sp-hole) * 2);
    border-radius: 50%;
    transform: translate(-50%, -50%);
    box-shadow: 0 0 0 1.5px rgba(214, 179, 112, 0.8);
    pointer-events: none;
  }
  .sp-reveal .sp-skip { opacity: 0; transition: opacity 0.2s; }
  .splash-on .bm-splash.sp-reveal.sp-fade { -webkit-mask-image: none; mask-image: none; animation: sp-exit var(--sp-reveal-t, 0.7s) ease-in-out forwards; }
  .sp-fade .sp-ring { display: none; }
  @keyframes sp-hole { from { --sp-hole: 0px; } to { --sp-hole: 72vmax; } }
  @keyframes sp-rise { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
  @keyframes sp-draw { from { transform: scaleX(0); } }
  @keyframes sp-exit { to { opacity: 0; transform: scale(1.04); visibility: hidden; } }
</style>
