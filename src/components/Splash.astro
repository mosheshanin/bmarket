---
/**
 * Заставка при открытии — 5 слайдов, ≈24 с (DECISIONS №50; стиль — №47; до 15.11.2026 — один экран ≈3 с).
 * Живой градиент фиолетовый → тёмно-синий → голубой, размытые пятна (оттенок меняется от слайда к слайду), 3D-иконки.
 *  1. «HaifaBusinessClub представляет» → логотип BMarket            — уход: «пролёт сквозь» (увеличение с размытием)
 *  2. N бизнесов в M городах, города «пилюлями»                       — уход: свайп влево с наклоном
 *  3. «Цифры — сразу»: пример настоящего лота (цена, прибыль, кольцо)  — уход: диагональная шторка с блеском
 *  4. «Название — после заявки»: плашка цензуры, перебор букв         — уход: «диафрагма» (круг из центра)
 *  5. Логотип и «Смотреть каталог» → раскрытие сайта круглым вырезом (0,7 с).
 * Нажатие на экран — следующий слайд, «Пропустить» — сразу на сайт. Точки внизу — где мы.
 * Показывается в Telegram (раз за открытие) и на сайте — при каждом входе извне и при обновлении страницы, но не при переходах
 * внутри сайта (решение — в <head> Layout.astro, класс .splash-on; DECISIONS №49). Не в админ-панели, не для роботов и
 * автотестов (принудительно — ?splash=1). При «уменьшении движения» — те же слайды без анимаций, со сменой затуханием.
 * Только публичные данные (catalogSummary, citiesWithListings, listPublished).
 */
import { catalogSummary, citiesWithListings, listPublished, type PublicListing } from '../server/public';
import { db } from '../server/site';
import { groupDigits, plural } from '../lib/format';
import { fromPrice } from '../lib/promo';
import { WORDMARK_D, WORDMARK_VIEWBOX } from '../lib/logo-path';

let count = 0;
let minPrice: number | null = null;
let cities: { name: string; count: number }[] = [];
let sample: PublicListing | null = null;
try {
  const d = db();
  const [sum, cityRows, latest] = await Promise.all([catalogSummary(d), citiesWithListings(d), listPublished(d, { limit: 30 })]);
  count = sum.count;
  minPrice = sum.minPrice;
  cities = [...cityRows].sort((a, b) => b.count - a.count);
  // Пример для слайда «Цифры»: лот со всеми цифрами и правдоподобной окупаемостью (6–60 мес), лучше — рекомендованный.
  const ok = latest.filter((l) => l.priceIls && l.monthlyProfitIls && l.paybackMonths && l.paybackMonths >= 6 && l.paybackMonths <= 60);
  sample = ok.find((l) => l.isFeatured) ?? ok[0] ?? null;
} catch {
  /* заставка не должна ломать страницу */
}
const from = fromPrice(minPrice);
const topCities = cities.slice(0, 5);
const ringLen = 2 * Math.PI * 26;
const ringPart = sample?.paybackMonths ? Math.min(1, sample.paybackMonths / 60) : 0;
const icons = [
  { n: 'briefcase', x: '12%', y: '16%', s: 64, r: -12, d: 0.35 },
  { n: 'money-bag', x: '78%', y: '20%', s: 72, r: 10, d: 0.5 },
  { n: 'key', x: '16%', y: '74%', s: 60, r: 18, d: 0.65 },
  { n: 'chart-increasing', x: '76%', y: '72%', s: 64, r: -8, d: 0.8 },
];
// Длительность слайдов, мс (последний — до начала раскрытия).
const durations = [5200, 4600, 5200, 4600, 3800];
---

<div id="bm-splash" class="bm-splash" data-s="0" data-durations={durations.join(',')}>
  <div class="sp-bg" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
  <div class="sp-sweep" aria-hidden="true"></div>
  <div class="sp-ring" aria-hidden="true"></div>

  <!-- 1. Логотип -->
  <section class="sp-slide is-on" data-out="zoom" aria-hidden="true">
    <div class="sp-icons">
      {icons.map((i) => (
        <img src={`/icons3d/${i.n}.webp`} alt="" width={i.s} height={i.s} decoding="async" style={`left:${i.x};top:${i.y};--r:${i.r}deg;--d:${i.d}s;width:${i.s}px;height:${i.s}px`} />
      ))}
    </div>
    <div class="sp-sc">
      <p class="sp-club sp-in" style="--d:0.05s">HaifaBusinessClub представляет</p>
      <svg class="sp-logo" viewBox={WORDMARK_VIEWBOX} role="img" aria-label="BMarket"><path fill="#fff" d={WORDMARK_D} /></svg>
      <p class="sp-note sp-in" style="--d:0.9s">Покупка и продажа бизнеса в Израиле</p>
    </div>
  </section>

  <!-- 2. Сколько и где -->
  <section class="sp-slide" data-out="swipe" aria-hidden="true">
    <div class="sp-sc">
      <img class="sp-hero sp-pop" src="/icons3d/cityscape.webp" alt="" width="120" height="120" decoding="async" />
      <p class="sp-big sp-in" style="--d:0.15s"><span data-sp-count={count}>{count}</span></p>
      <p class="sp-title sp-in" style="--d:0.25s">{plural(count, ['бизнес', 'бизнеса', 'бизнесов'])} на&nbsp;продажу</p>
      <p class="sp-text sp-in" style="--d:0.35s">в {cities.length} {plural(cities.length, ['городе', 'городах', 'городах'])} Израиля</p>
      <ul class="sp-chips">
        {topCities.map((c, i) => (
          <li class="sp-chip sp-pop" style={`--d:${0.55 + i * 0.12}s`}>{c.name} <b>{c.count}</b></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 3. Цифры сразу -->
  <section class="sp-slide" data-out="wipe" aria-hidden="true">
    <div class="sp-sc">
      <img class="sp-hero sp-pop" src="/icons3d/money-bag.webp" alt="" width="110" height="110" decoding="async" />
      <p class="sp-title sp-in" style="--d:0.1s">Цифры — сразу</p>
      {
        sample ? (
          <div class="sp-card sp-rise3d" style="--d:0.3s">
            <p class="sp-card-top">
              Лот №&nbsp;{sample.lotNumber}
              {sample.cityName && <> · {sample.cityName}</>}
            </p>
            <p class="sp-card-name">{sample.categoryName ?? sample.publicTitle}</p>
            <div class="sp-card-figs">
              <div>
                <span>Цена</span>
                <b>₪&nbsp;<i data-sp-count={sample.priceIls}>{groupDigits(sample.priceIls!)}</i></b>
              </div>
              <div>
                <span>Прибыль/мес</span>
                <b>₪&nbsp;<i data-sp-count={sample.monthlyProfitIls}>{groupDigits(sample.monthlyProfitIls!)}</i></b>
              </div>
              <div class="sp-card-ring">
                <svg width="60" height="60" viewBox="0 0 60 60" aria-hidden="true">
                  <circle cx="30" cy="30" r="26" fill="none" stroke="rgba(255,255,255,.22)" stroke-width="6" />
                  <circle class="sp-ring-arc" cx="30" cy="30" r="26" fill="none" stroke="#fff" stroke-width="6" stroke-linecap="round"
                    style={`--len:${ringLen.toFixed(1)};--part:${(ringLen * (1 - ringPart)).toFixed(1)}`} transform="rotate(-90 30 30)" />
                </svg>
                <span><b>{sample.paybackMonths}</b> мес<br />окупаемость</span>
              </div>
            </div>
          </div>
        ) : (
          <p class="sp-text sp-in" style="--d:0.3s">Цена, прибыль и окупаемость — в каждой карточке, от ₪&nbsp;{groupDigits(from)}</p>
        )
      }
      <p class="sp-text sp-in" style="--d:0.7s">Цена, прибыль и окупаемость видны в каждом лоте</p>
    </div>
  </section>

  <!-- 4. Название — после заявки -->
  <section class="sp-slide" data-out="iris" aria-hidden="true">
    <div class="sp-sc">
      <img class="sp-hero sp-pop" src="/icons3d/locked-with-key.webp" alt="" width="110" height="110" decoding="async" />
      <p class="sp-title sp-in" style="--d:0.1s">Название — после заявки</p>
      <div class="sp-redact sp-in" style="--d:0.25s">
        <span>Название:</span><i class="sp-bar"><em data-sp-scramble>■■■■■■■■■■■■■■■■</em></i>
      </div>
      <div class="sp-redact sp-in" style="--d:0.4s">
        <span>Адрес:</span><i class="sp-bar sp-bar-2"><em data-sp-scramble>■■■■■■■■■■■■</em></i>
      </div>
      <p class="sp-text sp-in" style="--d:0.6s">Конфиденциально: открывает менеджер клуба</p>
    </div>
  </section>

  <!-- 5. Финал -->
  <section class="sp-slide" aria-hidden="true">
    <div class="sp-icons">
      {icons.map((i) => (
        <img src={`/icons3d/${i.n}.webp`} alt="" width={i.s} height={i.s} decoding="async" style={`left:${i.x};top:${i.y};--r:${i.r}deg;--d:${(i.d - 0.3).toFixed(2)}s;width:${i.s}px;height:${i.s}px`} />
      ))}
    </div>
    <div class="sp-sc">
      <svg class="sp-logo sp-logo-sm" viewBox={WORDMARK_VIEWBOX} role="img" aria-label="BMarket"><path fill="#fff" d={WORDMARK_D} /></svg>
      <p class="sp-lead sp-in" style="--d:0.35s">{count ? <><b>{count}</b> {plural(count, ['бизнес', 'бизнеса', 'бизнесов'])} · </> : null}от ₪&nbsp;{groupDigits(from)}</p>
      <p class="sp-go sp-in" style="--d:0.6s">Смотреть каталог <span aria-hidden="true">→</span></p>
    </div>
  </section>

  <div class="sp-dots" aria-hidden="true">{durations.map(() => <i></i>)}</div>
  <button type="button" class="sp-skip" id="bm-splash-skip">Пропустить</button>
</div>

<script is:inline>
  (function () {
    var root = document.documentElement;
    var el = document.getElementById('bm-splash');
    if (!el) return;
    if (!root.classList.contains('splash-on')) {
      el.remove();
      return;
    }
    var slides = el.querySelectorAll('.sp-slide');
    var dots = el.querySelectorAll('.sp-dots i');
    var durations = (el.getAttribute('data-durations') || '').split(',').map(Number);
    var calm = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
    var cur = 0;
    var timer = 0;
    var finished = false;
    var revealing = false;
    function done() {
      if (finished) return;
      finished = true;
      clearTimeout(timer);
      root.classList.remove('splash-on');
      el.remove();
      window.__bmSplashDone = true;
      window.dispatchEvent(new Event('bm:splash-done'));
    }
    // Раскрытие круглым вырезом из центра; без поддержки CSS @property — плавное исчезновение.
    function reveal(ms) {
      if (revealing) return;
      revealing = true;
      clearTimeout(timer);
      el.style.setProperty('--sp-reveal-t', ms + 'ms');
      if (!(window.CSS && CSS.registerProperty)) el.classList.add('sp-fade');
      el.classList.add('sp-reveal');
      window.dispatchEvent(new Event('bm:splash-reveal'));
      setTimeout(done, ms + 50);
    }
    // Счёт чисел от нуля до значения (с разделением разрядов).
    function countUp(node) {
      var to = Number(node.getAttribute('data-sp-count')) || 0;
      if (calm || !to) return;
      var t0 = performance.now();
      var dur = 900;
      (function tick(now) {
        var k = Math.min(1, (now - t0) / dur);
        var v = Math.round(to * (1 - Math.pow(1 - k, 3)));
        node.textContent = String(v).replace(/\B(?=(\d{3})+(?!\d))/g, '\u00a0');
        if (k < 1 && !finished) requestAnimationFrame(tick);
      })(t0);
    }
    // Перебор букв под плашкой: «настоящее» название не показываем — только случайные символы.
    function scramble(node) {
      var len = (node.textContent || '').length;
      var abc = 'АБВГДЕЖЗИКЛМНОПРСТУФХЦЧШЭЮЯ0123456789';
      var n = 0;
      node.textContent = '';
      var id = setInterval(function () {
        var s = '';
        for (var i = 0; i < len; i++) s += abc[Math.floor(Math.random() * abc.length)];
        node.textContent = s;
        if (++n > 50 || finished) clearInterval(id);
      }, 70);
    }
    function show(i) {
      slides[i].classList.add('is-on');
      el.setAttribute('data-s', String(i));
      for (var d = 0; d < dots.length; d++) dots[d].classList.toggle('on', d === i);
      slides[i].querySelectorAll('[data-sp-count]').forEach(countUp);
      if (!calm) slides[i].querySelectorAll('[data-sp-scramble]').forEach(scramble);
    }
    function next() {
      if (revealing) return;
      clearTimeout(timer);
      if (cur >= slides.length - 1) return reveal(700);
      var prev = slides[cur];
      var out = prev.getAttribute('data-out') || 'fade';
      prev.classList.remove('is-on');
      prev.classList.add('is-out', 'out-' + out);
      el.classList.remove('tr-zoom', 'tr-swipe', 'tr-wipe', 'tr-iris');
      void el.offsetWidth;
      el.classList.add('tr-' + out);
      setTimeout(function () { prev.classList.remove('is-out', 'out-' + out); }, 900);
      cur++;
      slides[cur].classList.add('in-' + out);
      show(cur);
      timer = setTimeout(next, durations[cur] || 4400);
    }
    window.__bmSplashDone = false;
    document.getElementById('bm-splash-skip').addEventListener('click', function (e) { e.stopPropagation(); reveal(450); });
    // Нажатие на экран — следующий слайд.
    el.addEventListener('click', next);
    show(0);
    timer = setTimeout(next, durations[0] || 5200);
  })();
</script>

<style is:global>
  .bm-splash { display: none; }
  .splash-on body { overflow: hidden; }
  .splash-on .bm-splash {
    --sp-ease: cubic-bezier(0.16, 1, 0.3, 1);
    --sp-spring: cubic-bezier(0.3, 1.5, 0.5, 1);
    display: block;
    position: fixed;
    inset: 0;
    z-index: 100;
    overflow: hidden;
    background: linear-gradient(160deg, #5a47e5 0%, #7c4dee 35%, #2a3a95 62%, #0ea5e9 100%);
    color: #fff;
    font-family: var(--font-sans);
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    user-select: none;
  }
  /* Живой градиент: размытые пятна медленно плывут; от слайда к слайду меняется оттенок. */
  .sp-bg { position: absolute; inset: -20%; filter: blur(60px); transition: filter 1.2s ease, transform 1.2s var(--sp-ease); }
  .sp-bg i { position: absolute; display: block; border-radius: 50%; animation: sp-drift 6s ease-in-out infinite alternate; }
  .sp-bg i:nth-child(1) { width: 60vmax; height: 60vmax; left: -10%; bottom: 0; background: #b45cfa; }
  .sp-bg i:nth-child(2) { width: 45vmax; height: 45vmax; left: 40%; top: 18%; background: #1c2a6c; opacity: 0.85; animation-duration: 7s; }
  .sp-bg i:nth-child(3) { width: 55vmax; height: 55vmax; right: -15%; bottom: -5%; background: #0ea5e9; animation-duration: 5s; }
  .sp-bg i:nth-child(4) { width: 40vmax; height: 40vmax; left: 0; top: 0; background: #5145e2; opacity: 0.9; animation-duration: 8s; }
  .bm-splash[data-s='1'] .sp-bg { filter: blur(60px) hue-rotate(-28deg); transform: rotate(-8deg) scale(1.05); }
  .bm-splash[data-s='2'] .sp-bg { filter: blur(60px) hue-rotate(22deg); transform: rotate(10deg) scale(1.1); }
  .bm-splash[data-s='3'] .sp-bg { filter: blur(60px) hue-rotate(-12deg) brightness(0.8); transform: rotate(-4deg) scale(1.15); }
  .bm-splash[data-s='4'] .sp-bg { filter: blur(60px) hue-rotate(8deg); transform: none; }
  @keyframes sp-drift { to { transform: translate(6%, -5%) scale(1.12); } }

  /* Слайды: видимый — .is-on; уходящий — .is-out + .out-<переход>; входящий — .in-<переход>. */
  .sp-slide { position: absolute; inset: 0; visibility: hidden; pointer-events: none; }
  .sp-slide.is-on, .sp-slide.is-out { visibility: visible; }
  .sp-slide.is-out { z-index: 2; }

  .sp-icons img {
    position: absolute;
    translate: -50% -50%;
    opacity: 0;
    filter: drop-shadow(0 12px 18px rgba(20, 10, 80, 0.35));
  }
  .is-on .sp-icons img { animation: sp-pop 0.9s var(--sp-spring) var(--d) both, sp-bob 3s ease-in-out calc(var(--d) + 0.9s) infinite alternate; }
  .is-out .sp-icons img { opacity: 1; transform: rotate(var(--r)); }
  @keyframes sp-pop { from { opacity: 0; transform: scale(0.3) rotate(0deg); } to { opacity: 1; transform: scale(1) rotate(var(--r)); } }
  @keyframes sp-bob { from { opacity: 1; transform: rotate(var(--r)); } to { opacity: 1; transform: translateY(-10px) rotate(calc(var(--r) * -0.4)); } }
  @media (max-width: 480px) { .sp-icons img { scale: 0.8; } }
  @media (min-width: 900px) { .sp-icons img { scale: 1.5; } }

  .sp-sc {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 0 24px 60px;
    text-align: center;
  }
  /* Появление элементов слайда — только когда слайд показан (при каждом показе заново). */
  .sp-in, .sp-pop, .sp-rise3d { opacity: 0; }
  .is-on .sp-in { animation: sp-rise 0.9s var(--sp-ease) var(--d, 0s) both; }
  .is-on .sp-pop { animation: sp-pop-in 0.8s var(--sp-spring) var(--d, 0s) both; }
  .is-on .sp-rise3d { animation: sp-flip 1s var(--sp-ease) var(--d, 0s) both; }
  .is-out .sp-in, .is-out .sp-pop, .is-out .sp-rise3d { opacity: 1; }
  @keyframes sp-rise { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }
  @keyframes sp-pop-in { from { opacity: 0; transform: scale(0.4) rotate(-12deg); } to { opacity: 1; transform: none; } }
  @keyframes sp-flip { from { opacity: 0; transform: perspective(700px) rotateX(55deg) translateY(30px) scale(0.9); } to { opacity: 1; transform: none; } }

  .sp-club { margin: 0; font-size: 12px; font-weight: 900; letter-spacing: 0.18em; text-transform: uppercase; color: rgba(255, 255, 255, 0.82); }
  .sp-logo {
    display: block;
    width: min(78vw, 460px);
    height: auto;
    margin: 18px 0 0;
    overflow: visible;
    filter: drop-shadow(0 10px 30px rgba(20, 10, 90, 0.35));
  }
  .is-on .sp-logo { animation: sp-logo 1.1s cubic-bezier(0.2, 1.3, 0.4, 1) 0.2s both; }
  .sp-logo-sm { width: min(64vw, 360px); margin: 0; }
  .is-on .sp-logo-sm { animation-delay: 0.05s; }
  @keyframes sp-logo { from { opacity: 0; transform: scale(0.82); filter: blur(12px); } }
  .sp-note { margin: 14px 0 0; font-size: 15px; font-weight: 700; color: rgba(255, 255, 255, 0.88); }
  .sp-hero { width: 110px; height: 110px; filter: drop-shadow(0 16px 24px rgba(20, 10, 80, 0.4)); }
  .sp-big { margin: 6px 0 0; font-size: clamp(64px, 18vw, 112px); font-weight: 1000; line-height: 1; letter-spacing: -0.03em; font-variant-numeric: lining-nums tabular-nums; }
  .sp-title { margin: 8px 0 0; font-size: clamp(26px, 7vw, 40px); font-weight: 900; line-height: 1.1; letter-spacing: -0.015em; }
  .sp-text { margin: 10px 0 0; max-width: 420px; font-size: 16px; font-weight: 700; line-height: 1.4; color: rgba(255, 255, 255, 0.86); }
  .sp-chips { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; max-width: 460px; margin: 20px 0 0; padding: 0; list-style: none; }
  .sp-chip { padding: 8px 14px; border-radius: 999px; background: rgba(255, 255, 255, 0.16); border: 1px solid rgba(255, 255, 255, 0.3); font-size: 15px; font-weight: 800; -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); }
  .sp-chip b { margin-left: 4px; color: rgba(255, 255, 255, 0.75); font-weight: 900; }

  .sp-card {
    width: min(100%, 380px);
    margin: 18px 0 0;
    padding: 16px 18px;
    border-radius: 24px;
    background: rgba(255, 255, 255, 0.14);
    border: 1px solid rgba(255, 255, 255, 0.32);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    box-shadow: 0 20px 40px rgba(20, 10, 80, 0.3);
    text-align: left;
  }
  .sp-card-top { margin: 0; font-size: 11px; font-weight: 900; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(255, 255, 255, 0.75); }
  .sp-card-name { margin: 4px 0 0; font-size: 19px; font-weight: 900; line-height: 1.15; }
  .sp-card-figs { display: flex; align-items: flex-end; justify-content: space-between; gap: 10px; margin-top: 14px; padding-top: 12px; border-top: 1px dashed rgba(255, 255, 255, 0.35); }
  .sp-card-figs span { display: block; font-size: 11px; font-weight: 700; color: rgba(255, 255, 255, 0.75); }
  .sp-card-figs b { display: block; font-size: 19px; font-weight: 1000; white-space: nowrap; font-variant-numeric: tabular-nums; }
  .sp-card-figs i { font-style: normal; }
  .sp-card-ring { display: flex; align-items: center; gap: 6px; }
  .sp-card-ring span { font-size: 11px; line-height: 1.25; }
  .sp-card-ring span b { display: inline; font-size: 16px; }
  .sp-ring-arc { stroke-dasharray: var(--len); stroke-dashoffset: var(--len); }
  .is-on .sp-ring-arc { animation: sp-arc 1.2s var(--sp-ease) 0.6s forwards; }
