---
import type { CityWithCount } from '../server/public';

interface Props {
  cities: CityWithCount[];
  activeSlug?: string;
  /** Не используется (плашка «Все города» убрана), оставлено для совместимости вызовов. */
  total?: number;
}
const { cities, activeSlug } = Astro.props;
// Сначала города, где больше всего предложений; при равенстве — порядок из «Справочников».
const sorted = cities.map((c, i) => ({ c, i })).sort((a, b) => b.c.count - a.c.count || a.i - b.i).map((x) => x.c);
---

<nav aria-label="Города" class="-mx-4 mb-5 border-b border-line">
  <ul class="no-scrollbar flex gap-5 overflow-x-auto px-4" data-city-ribbon>
    {
      sorted.map((c) => (
        <li>
          <a href={`/city/${c.slug}`} class="city-tab" aria-current={activeSlug === c.slug ? 'page' : undefined} data-haptic="select">
            {c.name} · {c.count}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
<script>
  // Подсвеченный город — в зону видимости ленты.
  const active = document.querySelector<HTMLElement>('[data-city-ribbon] [aria-current="page"]');
  active?.scrollIntoView({ inline: 'center', block: 'nearest' });
</script>
