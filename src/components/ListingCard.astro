---
import type { PublicListing, DisplayRate } from '../server/public';
import { imageUrl, isNew } from '../server/public';
import { env } from '../server/site';
import { formatIls, formatUsd, formatPayback, groupDigits } from '../lib/format';
import { businessPath } from '../lib/slug';
import { ICON } from '../lib/icons';
import { extraByKey } from '../lib/extras';
import Icon from './ToneIcon.astro';
import TrustBadge from './TrustBadge.astro';

interface Props {
  item: PublicListing;
  rate: DisplayRate | null;
  eager?: boolean;
}
const { item, rate, eager = false } = Astro.props;
const href = businessPath(item.lotNumber, item.slug);
const cover = item.cover;
const fresh = isNew(item.publishedAt);
const trust = [item.valuationVerifiedAt && 'valuation', item.auditPassedAt && 'audit'].filter(Boolean) as ('valuation' | 'audit')[];
---

<a href={href} class="listing-card group flex h-full flex-col overflow-hidden text-text no-underline">
  <div class="relative aspect-[4/3] w-full overflow-hidden bg-line">
    {
      cover ? (
        <img
          src={imageUrl(env, cover.r2KeySmall)}
          srcset={`${imageUrl(env, cover.r2KeySmall)} 600w, ${imageUrl(env, cover.r2Key)} 1600w`}
          sizes="(min-width: 1024px) 380px, (min-width: 640px) 50vw, 100vw"
          alt={cover.alt || item.publicTitle}
          width="600"
          height="450"
          loading={eager ? 'eager' : 'lazy'}
          fetchpriority={eager ? 'high' : 'auto'}
          decoding="async"
          class="h-full w-full object-cover transition duration-300 group-hover:scale-[1.03]"
        />
      ) : (
        <div class="flex h-full items-center justify-center text-hint">Нет фото</div>
      )
    }
    {fresh && <span class="badge absolute left-2.5 top-2.5 bg-accent text-accent-text shadow-sm">Новое</span>}
    {
      trust.length > 0 && (
        <div class="absolute bottom-2.5 left-2.5 right-2.5 flex flex-wrap gap-1.5">
          {trust.map((k) => <TrustBadge kind={k} title={extraByKey(k)!.explain} />)}
        </div>
      )
    }
  </div>

  <div class="flex flex-1 flex-col p-4">
    <p class="flex items-center gap-1 text-[0.8rem] text-hint">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="shrink-0"><path d={ICON.pin} /></svg>
      <span class="truncate">{[item.cityName, item.categoryName].filter(Boolean).join(' · ')}</span>
    </p>
    <h3 class="mt-1 line-clamp-2 text-[1.02rem] font-semibold leading-snug">{item.publicTitle}</h3>

    <div class="mt-3 flex items-baseline justify-between gap-2">
      {item.priceIls ? <p class="text-[1.35rem] font-extrabold leading-none tracking-tight">{formatIls(item.priceIls)}</p> : <p class="font-semibold">Цена по запросу</p>}
      {item.priceIls && rate && <p class="shrink-0 text-xs text-hint">{formatUsd(item.priceIls, rate.usdIls)}</p>}
    </div>

    {
      (item.monthlyProfitIls || item.paybackMonths) && (
        <div class="mt-auto grid grid-cols-2 gap-2 pt-3.5">
          {item.monthlyProfitIls ? (
            <div class="tone-green flex items-center gap-2">
              <Icon d={ICON.profit} small />
              <div class="min-w-0 leading-tight">
                <p class="text-[0.7rem] text-hint">Прибыль/мес</p>
                <p class="truncate text-sm font-semibold">₪&nbsp;{groupDigits(item.monthlyProfitIls)}</p>
              </div>
            </div>
          ) : <div />}
          {item.paybackMonths ? (
            <div class="tone-violet flex items-center gap-2">
              <Icon d={ICON.payback} small />
              <div class="min-w-0 leading-tight">
                <p class="text-[0.7rem] text-hint">Окупаемость</p>
                <p class="truncate text-sm font-semibold">{formatPayback(item.paybackMonths)}</p>
              </div>
            </div>
          ) : <div />}
        </div>
      )
    }
  </div>
</a>
