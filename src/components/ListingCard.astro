---
import type { PublicListing, DisplayRate } from '../server/public';
import { imageUrl, isNew } from '../server/public';
import { env } from '../server/site';
import { formatIls, formatUsd, formatPayback, groupDigits } from '../lib/format';
import { businessPath } from '../lib/slug';

interface Props {
  item: PublicListing;
  rate: DisplayRate | null;
  eager?: boolean;
}
const { item, rate, eager = false } = Astro.props;
const href = businessPath(item.lotNumber, item.slug);
const cover = item.cover;
const fresh = isNew(item.publishedAt);
---

<a href={href} class="card group flex flex-col overflow-hidden text-text no-underline transition hover:-translate-y-0.5">
  <div class="relative aspect-[4/3] w-full overflow-hidden bg-line">
    {
      cover ? (
        <img
          src={imageUrl(env, cover.r2KeySmall)}
          srcset={`${imageUrl(env, cover.r2KeySmall)} 600w, ${imageUrl(env, cover.r2Key)} 1600w`}
          sizes="(min-width: 1024px) 380px, (min-width: 640px) 50vw, 100vw"
          alt={cover.alt || item.publicTitle}
          width="600"
          height="450"
          loading={eager ? 'eager' : 'lazy'}
          fetchpriority={eager ? 'high' : 'auto'}
          decoding="async"
          class="h-full w-full object-cover"
        />
      ) : (
        <div class="flex h-full items-center justify-center text-hint">Нет фото</div>
      )
    }
    <div class="absolute left-2 top-2 flex gap-1.5">
      {fresh && <span class="badge bg-accent text-accent-text">Новое</span>}
    </div>
  </div>
  <div class="flex flex-1 flex-col gap-1.5 p-3.5">
    <h3 class="text-[1.02rem] font-semibold leading-snug">{item.publicTitle}</h3>
    <p class="text-sm text-hint">
      {[item.cityName, item.categoryName].filter(Boolean).join(' · ')}
    </p>
    <div class="mt-auto pt-2">
      {item.priceIls ? <p class="text-xl font-extrabold tracking-tight">{formatIls(item.priceIls)}</p> : <p class="font-semibold">Цена по запросу</p>}
      {item.priceIls && rate && <p class="text-sm text-hint">{formatUsd(item.priceIls, rate.usdIls)}</p>}
      {
        (item.monthlyProfitIls || item.paybackMonths) && (
          <p class="mt-1.5 text-sm">
            {item.monthlyProfitIls && <span>Прибыль ₪&nbsp;{groupDigits(item.monthlyProfitIls)}/мес</span>}
            {item.monthlyProfitIls && item.paybackMonths && <span class="text-hint"> · </span>}
            {item.paybackMonths && <span>окупаемость {formatPayback(item.paybackMonths)}</span>}
          </p>
        )
      }
    </div>
  </div>
</a>
