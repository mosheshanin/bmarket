---
/**
 * Карточка-досье в ленте (концепция «Закрытый клуб», DECISIONS №46):
 * ярлык папки с номером лота, наклонённое фото, плашка цензуры на месте названия,
 * цифры антиквой и кольцо окупаемости. Настоящего названия в HTML нет — плашка пустая.
 * Фото несёт view-transition-name: при переходе в карточку оно «перелетает» в галерею.
 */
import type { PublicListing, DisplayRate } from '../server/public';
import { imageUrl, isIllustrativePhoto, isNew } from '../server/public';
import { env } from '../server/site';
import { formatIls, formatUsd, groupDigits, plural } from '../lib/format';
import { businessPath } from '../lib/slug';
import { extraByKey } from '../lib/extras';
import TrustBadge from './TrustBadge.astro';
import PaybackRing from './PaybackRing.astro';

interface Props {
  item: PublicListing;
  rate: DisplayRate | null;
  eager?: boolean;
}
const { item, rate, eager = false } = Astro.props;
const href = businessPath(item.lotNumber, item.slug);
const cover = item.cover;
const fresh = isNew(item.publishedAt);
const trust = [item.valuationVerifiedAt && 'valuation', item.auditPassedAt && 'audit'].filter(Boolean) as ('valuation' | 'audit')[];
const payback = item.paybackMonths
  ? item.paybackMonths < 24
    ? `${item.paybackMonths} мес`
    : `${String(Math.round((item.paybackMonths / 12) * 10) / 10).replace('.', ',')} ${plural(Math.round(item.paybackMonths / 12), ['год', 'года', 'лет'])}`
  : null;
// Ширина плашки зависит от номера лота (не от названия), чтобы плашки в ленте не были одинаковыми.
const redactW = 64 + ((item.lotNumber * 37) % 56);
---

<a href={href} class="dossier press listing-card h-full" data-haptic>
  <span class="dossier-tab caps">
    Досье №&nbsp;{item.lotNumber}
    {fresh && <span class="rounded-full bg-accent px-2 py-0.5 text-[9.5px] tracking-[0.1em] text-accent-text">Новое</span>}
  </span>
  <div class="dossier-body">
    <div class="flex gap-3.5">
      <div class="dossier-thumb" style={`view-transition-name: lot-${item.lotNumber}`}>
        {
          cover ? (
            <img
              src={imageUrl(env, cover.r2KeySmall)}
              srcset={`${imageUrl(env, cover.r2KeySmall)} 600w, ${imageUrl(env, cover.r2Key)} 1600w`}
              sizes="120px"
              alt={cover.alt || item.publicTitle}
              width="600"
              height="450"
              loading={eager ? 'eager' : 'lazy'}
              fetchpriority={eager ? 'high' : 'auto'}
              decoding="async"
            />
          ) : (
            <span class="flex h-full items-center justify-center text-xs text-hint">Нет фото</span>
          )
        }
        {cover && isIllustrativePhoto(cover.r2Key) && <span class="photo-illustr">Фото для иллюстрации</span>}
      </div>
      <div class="flex min-w-0 flex-1 flex-col gap-1.5">
        <p class="truncate text-[0.78rem] text-hint">{[item.cityName, item.categoryName].filter(Boolean).join(' · ')}</p>
        <h3 class="serif line-clamp-3 text-[1.32rem] leading-[1.08]">{item.publicTitle}</h3>
        <p class="mt-auto flex items-center gap-1.5 text-[0.75rem] text-hint">
          Название: <span class="redact" style={`width:${redactW}px`} title="Название — после заявки" aria-hidden="true"></span>
        </p>
        {
          trust.length > 0 && (
            <div class="flex flex-wrap gap-1.5 pt-0.5">
              {trust.map((k) => <TrustBadge kind={k} title={extraByKey(k)!.explain} />)}
            </div>
          )
        }
      </div>
    </div>

    <div class="mt-auto grid grid-cols-[minmax(0,1.25fr)_minmax(0,1fr)_auto] items-end gap-3 border-t border-dashed border-line pt-3">
      <div class="min-w-0">
        <span class="fig-label">Цена</span>
        {item.priceIls ? (
          <span class="serif block truncate text-[1.45rem] leading-none">{formatIls(item.priceIls)}</span>
        ) : (
          <span class="block font-semibold">по запросу</span>
        )}
        {item.priceIls && rate && <span class="mt-1 block truncate text-[0.7rem] text-hint">{formatUsd(item.priceIls, rate.usdIls)}</span>}
      </div>
      <div class="min-w-0">
        {item.monthlyProfitIls ? (
          <>
            <span class="fig-label">Прибыль/мес</span>
            <span class="serif block truncate text-[1.15rem] leading-none">₪&nbsp;{groupDigits(item.monthlyProfitIls)}</span>
          </>
        ) : null}
      </div>
      {
        payback ? (
          <div class="flex items-center gap-1.5" title={`Окупаемость: ${payback}`}>
            <PaybackRing months={item.paybackMonths!} size={36} />
            <span class="leading-tight">
              <span class="serif block text-[1.05rem]">{payback}</span>
              <span class="fig-label">окупаемость</span>
            </span>
          </div>
        ) : <div />
      }
    </div>
  </div>
</a>
