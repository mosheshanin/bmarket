---
import '../styles/global.css';
import { site } from '../server/site';
import Splash from '../components/Splash.astro';
// Шрифты концепции «Закрытый клуб»: Manrope (текст) и Cormorant Garamond 700 (заголовки, цифры).
// Кириллица подгружается заранее, латиница — когда встретится на странице.
import manropeCyrillic from '@fontsource-variable/manrope/files/manrope-cyrillic-wght-normal.woff2?url';
import manropeLatin from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import serifCyrillic from '@fontsource/cormorant-garamond/files/cormorant-garamond-cyrillic-700-normal.woff2?url';
import serifLatin from '@fontsource/cormorant-garamond/files/cormorant-garamond-latin-700-normal.woff2?url';
// Для заставки (латинские BMarket, HaifaBusinessClub) латиница тоже нужна сразу.
const splashFonts = [serifLatin, manropeLatin];

interface Props {
  title: string;
  description?: string;
  /** Путь канонического адреса, например «/city/haifa». */
  canonicalPath?: string;
  ogImage?: string | null;
  ogType?: string;
  jsonLd?: unknown[];
  noindex?: boolean;
  /** data-атрибуты для клиентского скрипта: page, business-id, lot, request-path… */
  data?: Record<string, string | number | undefined>;
  bare?: boolean;
}

const { title, description, canonicalPath, ogImage, ogType = 'website', jsonLd = [], noindex = false, data = {}, bare = false } = Astro.props;
const s = site();
const canonical = canonicalPath ? s.url + canonicalPath : undefined;
const dataAttrs = Object.fromEntries(
  Object.entries({ ...data, miniapp: s.miniAppLink ?? undefined })
    .filter(([, v]) => v !== undefined && v !== null && v !== '')
    .map(([k, v]) => [`data-${k}`, String(v)]),
);
const ldJson = jsonLd.map((x) => JSON.stringify(x).replace(/</g, '\\u003c'));
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#efe9de" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#13110e" media="(prefers-color-scheme: dark)" />
    <meta property="og:site_name" content={s.name} />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={manropeCyrillic} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={serifCyrillic} as="font" type="font/woff2" crossorigin />
    {ldJson.map((j) => <script type="application/ld+json" set:html={j} />)}
    <!-- Внутри Telegram: пометить документ и подключить SDK мини-приложения (в браузере не грузится). -->
    <script is:inline define:vars={{ splashFonts }}>
      (function () {
        try {
          var root = document.documentElement;
          // Анимации — только если не включено «уменьшение движения».
          if (!(window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches)) root.classList.add('motion-ok');
          var tg = /tgWebApp/.test(location.hash + location.search) || sessionStorage.getItem('bm_tg') === '1';
          if (!tg) return;
          sessionStorage.setItem('bm_tg', '1');
          root.classList.add('tg');
          // Светлая или тёмная палитра — как в Telegram, до отрисовки (без мигания). Тема клиента приходит в адресе
          // только при открытии; на следующих страницах — из sessionStorage. Потом её уточняет src/scripts/app.ts.
          var scheme = sessionStorage.getItem('bm_scheme');
          var tp = /tgWebAppThemeParams=([^&]+)/.exec(location.hash);
          if (tp) {
            try {
              var hex = (JSON.parse(decodeURIComponent(tp[1])).bg_color || '').replace('#', '');
              if (hex.length === 6) {
                var lum = 0.2126 * parseInt(hex.slice(0, 2), 16) + 0.7152 * parseInt(hex.slice(2, 4), 16) + 0.0722 * parseInt(hex.slice(4, 6), 16);
                scheme = lum < 128 ? 'dark' : 'light';
              }
            } catch (e) {}
          }
          if (scheme === 'dark' || scheme === 'light') {
            root.classList.add('theme-' + scheme);
            sessionStorage.setItem('bm_scheme', scheme);
          }
          // Заставка — один раз на открытие мини-приложения (сессия Telegram WebView),
          // не в админке, не при «уменьшении движения». Если сейчас будет переход по прямой
          // ссылке (?startapp=lot-…), заставку покажет страница, на которую ведёт ссылка.
          var url = location.search + location.hash;
          var willRedirect = /tgWebAppStartParam=((lot|lead|biz|sell)-\d+|sell)(&|$)/.test(url) && !sessionStorage.getItem('bm_sp');
          var calm = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
          if (!willRedirect && !calm && !sessionStorage.getItem('bm_splash') && location.pathname.indexOf('/admin') !== 0) {
            sessionStorage.setItem('bm_splash', '1');
            document.documentElement.classList.add('splash-on');
            splashFonts.forEach(function (href) {
              var l = document.createElement('link');
              l.rel = 'preload';
              l.as = 'font';
              l.type = 'font/woff2';
              l.crossOrigin = 'anonymous';
              l.href = href;
              document.head.appendChild(l);
            });
          }
          var s = document.createElement('script');
          s.src = 'https://telegram.org/js/telegram-web-app.js?59';
          s.async = false;
          document.head.appendChild(s);
        } catch (e) {}
      })();
    </script>
    {
      s.analyticsToken && (
        <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: s.analyticsToken })} />
      )
    }
  </head>
  <body {...dataAttrs}>
    {!bare && <Splash />}
    {
      !bare && (
        <header class="web-only sticky top-0 z-30 border-b border-line bg-bg/95 backdrop-blur">
          <div class="mx-auto flex h-14 max-w-[1200px] items-center justify-between gap-3 px-4">
            <a href="/" class="flex items-baseline gap-2.5 text-text no-underline">
              <span class="serif text-[1.6rem] leading-none">{s.name}</span>
              <span class="caps hidden text-brass sm:inline">HaifaBusinessClub</span>
            </a>
            {s.miniAppLink && (
              <a href={s.miniAppLink} class="btn btn-secondary !min-h-[40px] text-sm" rel="noopener">
                Открыть в Telegram
              </a>
            )}
          </div>
        </header>
      )
    }
    <a id="admin-link" href="/admin" class="fixed bottom-[calc(env(safe-area-inset-bottom)+12px)] right-3 z-40 items-center gap-1.5 rounded-full bg-accent px-4 py-2.5 text-sm font-semibold text-accent-text shadow-card no-underline" style="display:none">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1Z"/></svg>
      Админ-панель
    </a>
    <main class="mx-auto w-full max-w-[1200px] px-4 pb-28 pt-4">
      <slot />
    </main>
    {
      !bare && (
        <footer class="web-only border-t border-line">
          <div class="mx-auto flex max-w-[1200px] flex-wrap gap-x-5 gap-y-2 px-4 py-6 text-sm text-hint">
            <span>© {new Date().getFullYear()} {s.name}</span>
            <a href="/about">О сервисе</a>
            <a href="/privacy">Политика конфиденциальности</a>
          </div>
        </footer>
      )
    }
    <script>
      import '../scripts/app';
    </script>
  </body>
</html>
