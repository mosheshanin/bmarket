  "type": "module",
  "version": "0.1.0",
  "dependencies": {
    "@astrojs/react": "^7.1.1",
    "@astrojs/vercel": "^11.0.21",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/nunito": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vercel/functions": "^3.11.1",
    "astro": "^7.4.2",
    "drizzle-orm": "^0.45.4",
    "grammy": "^1.46.0",
    "marked": "^18.1.1",
    "postgres": "^4.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro check && tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/smoke.mjs",
    "db:generate": "drizzle-kit generate",
    "bot:setup": "node scripts/setup-bot.mjs",
