{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Production: ветка main → Worker «bmarket» (автодеплой Cloudflare Workers Builds).
  "name": "bmarket",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "workers_dev": true,
  // ID версии Worker входит в ключ кеша страниц: после деплоя HTML не ссылается на удалённые CSS/JS.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "assets": { "binding": "ASSETS", "directory": "./dist/client" },
  // 2 задачи по расписанию из 5 бесплатных:
  //   каждую минуту — самонастройка бота после деплоя и рассылка подписчикам порциями;
  //   ежедневно в 14:00 UTC — курсы Банка Израиля и обслуживание базы.
  "triggers": { "crons": ["* * * * *", "0 14 * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "catalog-prod",
      "database_id": "203711a2-331e-4498-9572-514182e7623e",
      "migrations_dir": "migrations"
    }
  ],
  // Фото — в Workers KV (R2 в аккаунте не включён). Чтобы перейти на R2, добавьте привязку
  // "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "bmarket-photos" }] — код подхватит её сам.
  "kv_namespaces": [{ "binding": "PHOTOS_KV", "id": "a173fe0067944711b424d830b5905315" }],
  "vars": {
    "SITE_URL": "https://bmarket.moshemadwords.workers.dev",
    "PUBLIC_IMAGES_URL": "",
    "ADMIN_TELEGRAM_IDS": "352078684",
    "MANAGERS_CHAT_ID": "-5528365586",
    "TELEGRAM_BOT_USERNAME": "bismarketbot",
    "TELEGRAM_APP_SHORT_NAME": "app",
    "TURNSTILE_SITE_KEY": "",
    "CF_ANALYTICS_TOKEN": "",
    "PROJECT_NAME": "BMarket"
  }
  // Секрет задаётся в панели Cloudflare (Worker → Settings → Variables and Secrets) или `wrangler secret put`:
  //   TELEGRAM_BOT_TOKEN — токен бота. Секрет вебхука выводится из него автоматически.
  //   TURNSTILE_SECRET_KEY — после подключения домена и Turnstile.
}
