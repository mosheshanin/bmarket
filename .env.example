# Скопируйте в .env для локального запуска (файл в .gitignore): cp .env.example .env
# В Vercel переменные задаются в Project → Settings → Environment Variables (секреты вводит владелец).
#
# Локальный Postgres (npm run db:local) и папка для фото вместо Supabase Storage.
DATABASE_URL=postgres://postgres@127.0.0.1:54329/bmarket
PHOTOS_DIR=.data/photos
CRON_SECRET=local-cron-secret
TELEGRAM_BOT_TOKEN=123456:TEST-TOKEN-FOR-LOCAL-DEV
TELEGRAM_WEBHOOK_SECRET=local-webhook-secret
TURNSTILE_SECRET_KEY=
SITE_URL=http://localhost:4321
ADMIN_TELEGRAM_IDS=111111,222222
MANAGERS_CHAT_ID=
TELEGRAM_BOT_USERNAME=bmarket_test_bot

# PayPal (секреты). Для e2e-теста: PAYPAL_API_BASE=http://127.0.0.1:8799 — поддельный PayPal из tests/e2e/smoke.mjs.
PAYPAL_CLIENT_ID=test-client
PAYPAL_CLIENT_SECRET=test-secret
PAYPAL_WEBHOOK_ID=WH-TEST
PAYPAL_API_BASE=http://127.0.0.1:8799
# В сквозных тестах онлайн-оплата включена, чтобы проверить PayPal (в production — выключена).
ONLINE_PAYMENTS=1
